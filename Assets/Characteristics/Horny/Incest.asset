  _name: "\u0418\u043D\u0446\u0435\u0441\u0442"
  _definition: "\u0421\u0435\u043A\u0441\u0443\u0430\u043B\u044C\u043D\u043E\u0435
    \u0432\u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u043A \u0440\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430\u043C"
  _icon: {fileID: 21300000, guid: 1cb7ec78d32a69943b3c5ac0036045b6, type: 3}
  _levels:
  - name: "\u041D\u0435\u0432\u0435\u0434\u0435\u043D\u0438\u0435"
    valueToReach: 0
    description: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E \u043E \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0438
      \u044D\u0442\u043E\u0433\u043E"
    color: {r: 0.5754717, g: 0, b: 0.11813163, a: 1}
  - name: "\u0421\u0442\u0440\u0430\u0448\u043D\u043E"
    valueToReach: 10
    description: "\u041C\u044B\u0441\u043B\u0438 \u043E\u0431 \u044D\u0442\u043E\u043C
      \u043C\u0435\u043D\u044F \u043F\u0443\u0433\u0430\u044E\u0442"
    color: {r: 0.2245533, g: 0.5283019, b: 0.21181916, a: 0}
  - name: "\u041D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E"
    valueToReach: 25
    description: "\u042F \u0437\u043D\u0430\u044E \u043E\u0431 \u044D\u0442\u043E\u043C,
      \u043D\u043E \u0441\u0430\u043C\u0430 \u0434\u0435\u043B\u0430\u0442\u044C
      \u043D\u0435 \u0445\u043E\u0447\u0443"
    color: {r: 0, g: 0.5978147, b: 0.735849, a: 0}
  - name: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E"
    valueToReach: 50
    description: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u044F \u0431\u044B
      \u0445\u043E\u0442\u0435\u043B\u0430 \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
      \u044D\u0442\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C,
      \u043D\u043E \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    color: {r: 0.6502069, g: 0.6886792, b: 0.21764861, a: 0}
  - name: "\u0417\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u043E"
    valueToReach: 75
    description: "\u042F \u043E\u0447\u0435\u043D\u044C \u0445\u043E\u0447\u0443
      \u044D\u0442\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C"
    color: {r: 0.5283019, g: 0.11712353, b: 0.5056599, a: 0}
  - name: "\u0416\u0430\u0436\u0434\u0430"
    valueToReach: 100
    description: "\u042F \u0445\u043E\u0447\u0435\u0448\u044C \u0434\u0435\u043B\u0430\u0442\u044C
      \u044D\u0442\u043E \u0447\u0430\u0449\u0435"
    color: {r: 1, g: 0, b: 0, a: 0}
  - name: "\u0417\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C"
    valueToReach: 150
    description: "\u0422\u044B \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0435\u0431\u044F \u0438 \u0434\u0435\u043B\u0430\u0435\u0448\u044C
      \u044D\u0442\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u043E."
    color: {r: 0, g: 0, b: 0, a: 0}
