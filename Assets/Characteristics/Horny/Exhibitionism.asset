  - name: "\u0418\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E"
    valueToReach: 30
    description: "\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u044F \u0431\u044B
